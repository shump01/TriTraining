// Prisma 7 schema. Docs: https://pris.ly/d/prisma-schema
//
// The new `prisma-client` generator is used (the legacy `prisma-client-js`
// provider is deprecated in v7). The generated client is written to a custom
// `output` path (required in v7) and imported from there in application code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7 the connection URL lives in prisma.config.ts (for the CLI /
  // Migrate) and is supplied to PrismaClient via the driver adapter at runtime.
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js (NextAuth v5) models — per the @auth/prisma-adapter spec.
// `User.passwordHash` is our addition for email + password credentials login
// (nullable so OAuth-only users are also supported). Never stores plaintext.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String? // argon2id hash; null for users without a password
  // Lactate-threshold heart rate (bpm) — required to compute HR-based training
  // load (hrTSS). Null until the athlete sets it. See src/lib/training-load.ts.
  thresholdHr      Int?
  accounts         Account[]
  sessions         Session[]
  trainingPlans    TrainingPlan[]
  activityLoads    ActivityLoad[]
  stravaConnection StravaConnection?
  garminConnection GarminConnection?
  garminActivities GarminActivity[]
  ownedGroups      Group[]           @relation("GroupOwner")
  groupMemberships GroupMembership[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// Per-activity heart-rate data for training load (hrTSS → CTL/ATL/TSB). Populated
// by the Strava sync and the Apple Health ingest for activities that recorded HR;
// whole-athlete (not tied to a plan). TSS is NOT stored — it's derived from
// movingSeconds + avgHr + the user's current thresholdHr at read time, so changing
// threshold recomputes. Each writer replaces only its own `source` rows, and reads
// use ONE source (see readUserLoad) so a workout reaching us from both Strava and
// Apple Health never double-counts.
model ActivityLoad {
  id            String       @id @default(cuid())
  userId        String
  // Strava activity id or HealthKit workout UUID — the per-source idempotency
  // key. Maps onto the pre-generalization column name (no data migration).
  externalId    String       @map("stravaActivityId")
  // Which sync wrote the row. Reuses ActualSource; MANUAL is never written here.
  source        ActualSource @default(STRAVA)
  date          DateTime     @db.Date // local activity date (for daily bucketing)
  discipline    Discipline
  movingSeconds Int
  avgHr         Int // only activities with recorded HR are stored
  createdAt     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId], map: "ActivityLoad_userId_source_stravaActivityId_key")
  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Training groups — a light social layer. A group has one owner and many
// members; members can see each other's high-level (per-sport current-week %)
// progress. Joining is via a shareable link keyed by `inviteToken`.
//
// IMPORTANT: a group is the ONLY place one user's data is visible to another.
// All access is gated on the requester's membership; see src/lib/groups.ts.
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  inviteToken String   @unique // shareable-link secret; the owner can rotate it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMembership[]

  @@index([ownerId])
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per (group, user) — makes joins idempotent.
  @@unique([groupId, userId])
  @@index([userId])
}

// Strava OAuth account link (separate from login). access/refresh tokens are
// stored ENCRYPTED at rest (AES-256-GCM) — never plaintext. One per user.
model StravaConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  athleteId    String // Strava athlete id (stored as string to avoid bigint issues)
  accessToken  String // AES-256-GCM ciphertext
  refreshToken String // AES-256-GCM ciphertext
  expiresAt    DateTime // access-token expiry
  scope        String
  lastSyncedAt DateTime? // last successful activity sync
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([athleteId])
}

// Garmin OAuth account link — dormant until the Garmin Connect Developer
// Program grants credentials (see GARMIN_INTEGRATION_PLAN.md). Tokens are
// stored ENCRYPTED at rest (AES-256-GCM), like Strava's. Garmin refresh tokens
// ROTATE on every refresh, so refreshToken is always the most recent one.
model GarminConnection {
  id               String    @id @default(cuid())
  userId           String    @unique
  garminUserId     String // stable Garmin API user id (GET /user/id)
  accessToken      String // AES-256-GCM ciphertext (~24h lifetime)
  refreshToken     String // AES-256-GCM ciphertext (~90 days, rotates)
  expiresAt        DateTime // access-token expiry
  refreshExpiresAt DateTime? // refresh-token expiry (reconnect needed after)
  permissions      String? // granted permissions, comma-joined (e.g. "ACTIVITY_EXPORT")
  lastEventAt      DateTime? // last webhook delivery or backfill receipt
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Webhook payloads identify users by Garmin user id, not our session.
  @@index([garminUserId])
}

// Durable per-activity store for Garmin push deliveries. Garmin retains data
// server-side for only ~7 days and offers no polling, so this table is the
// system of record: GARMIN-sourced WeeklyActual and ActivityLoad rows are
// recomputed from it after every delivery (see src/lib/garmin/recompute.ts).
// The webhook upserts on (userId, activityId) — an edited activity arrives as
// a fresh summary for the same activityId. Only summaries that map to a
// tracked discipline are stored; MULTI_SPORT parents and TRANSITION segments
// are skipped at normalization (the swim/bike/run legs carry the real data).
model GarminActivity {
  id              String   @id @default(cuid())
  userId          String
  activityId      String // Garmin Connect activity id (string to avoid bigint issues)
  summaryId       String // per-delivery id (changes when the activity is edited)
  sportType       String // Garmin activityType, e.g. LAP_SWIMMING, ROAD_BIKING
  startTimeUtc    DateTime // startTimeInSeconds (UTC instant)
  offsetSeconds   Int // startTimeOffsetInSeconds — derives the athlete's local time
  distanceMeters  Float
  durationSeconds Int
  avgHr           Int? // averageHeartRateInBeatsPerMinute, when the device recorded HR
  deviceName      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId, startTimeUtc])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Training plan domain.
//
// Every record is scoped to a user: TrainingPlan.userId is the FK, and all child
// records hang off a TrainingPlan (so they are transitively user-scoped). Deleting
// a user cascades to their plans; deleting a plan cascades to all of its children.
//
// IMPORTANT: application code must always filter by the *authenticated* user id
// (from the session), never a client-supplied one — see src/lib/training-plan.ts.
// ─────────────────────────────────────────────────────────────────────────────

enum Discipline {
  SWIM
  BIKE
  RUN
}

enum ActualSource {
  MANUAL
  STRAVA
  APPLE_HEALTH
  GARMIN
}

enum PauseReason {
  ILLNESS
  INJURY
  TRAVEL
  OTHER
}

model TrainingPlan {
  id             String    @id @default(cuid())
  userId         String
  name           String
  eventDate      DateTime  @db.Date
  // Week 1's Monday. Nullable for plans created before this column existed; for
  // those the effective start falls back to firstMondayOnOrAfter(createdAt).
  startDate      DateTime? @db.Date
  // Hard cap on weekly volume, as a multiple of each discipline's event
  // distance (see computeWeeklyTargets). Defaults to 1.5x.
  capMultiple    Float     @default(1.5)
  // Race-week taper: the final N weeks ramp down from the peak into race day
  // (see computeWeeklyTargets). 0 = no taper (peak on the event week). Default 2.
  taperWeeks     Int       @default(2)
  // Season priority: "A" (goal race), "B", or "C" (tune-up). Drives the season
  // timeline's emphasis. Default "A".
  priority       String    @default("A")
  // Secret for a public read-only share link (/shared/<token>). Null = not
  // shared; the owner can generate and revoke it. Unique so a token maps to one plan.
  shareToken     String?   @unique
  // Day every training week begins on: 0=Sun..6=Sat. Defaults to Monday (1),
  // which matches the Monday-aligned data of plans created before this column.
  weekStartDay   Int       @default(1)
  // Week-start date of the last adaptive recompute (see maybeRecalculatePlan) —
  // ensures the weekly re-ramp runs at most once per week. Null until it first runs.
  lastRecalcWeek DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  disciplines    PlanDiscipline[]
  weeklyTargets  WeeklyTarget[]
  weeklyActuals  WeeklyActual[]
  weeklyCheckins WeeklyCheckin[]
  weeklyPauses   WeeklyPause[]

  @@index([userId])
}

model PlanDiscipline {
  id                   String     @id @default(cuid())
  planId               String
  discipline           Discipline
  eventDistanceMeters  Int
  startingWeeklyMeters Int

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // One row per discipline per plan. The unique index also serves planId lookups.
  @@unique([planId, discipline])
}

model WeeklyTarget {
  id            String     @id @default(cuid())
  planId        String
  discipline    Discipline
  weekStartDate DateTime   @db.Date
  targetMeters  Int

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, weekStartDate])
}

model WeeklyActual {
  id            String       @id @default(cuid())
  planId        String
  discipline    Discipline
  weekStartDate DateTime     @db.Date
  actualMeters  Int
  source        ActualSource

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // One actual per plan/discipline/week/source — the idempotency key for sync.
  @@unique([planId, discipline, weekStartDate, source])
  @@index([planId, weekStartDate])
}

// A subjective weekly wellness check-in (1–5 scales). Feeds the adaptive
// re-ramp: a fatigued/sore/under-slept week eases the following weeks' volume
// (see checkinReadinessFactor + maybeRecalculatePlan). One per plan+week.
model WeeklyCheckin {
  id            String   @id @default(cuid())
  planId        String
  weekStartDate DateTime @db.Date
  fatigue       Int // 1 = fresh … 5 = exhausted
  sleep         Int // 1 = poor … 5 = great
  soreness      Int // 1 = none … 5 = very sore
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekStartDate])
  @@index([planId, weekStartDate])
}

// A week the athlete could not train (illness / injury / travel). Marks the week
// as "no training expected" rather than "missed", which changes two behaviours:
// the week is excluded from the readiness trend and adherence (so time off never
// reads as being behind), and on return the plan re-ramps from a *detrained*
// baseline instead of the stale pre-pause target — see returnToTrainingFactor +
// maybeRecalculatePlan. One per plan+week.
model WeeklyPause {
  id            String      @id @default(cuid())
  planId        String
  weekStartDate DateTime    @db.Date
  reason        PauseReason
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekStartDate])
  @@index([planId, weekStartDate])
}
