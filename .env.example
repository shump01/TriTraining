# ─────────────────────────────────────────────────────────────────────────────
# TriTrainer — environment variables
#
# Copy this file to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored — NEVER commit real secrets.
#
# Every variable below is REQUIRED. They are validated at boot by src/env.ts
# (zod); the app refuses to start if any is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by the app at runtime.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Hosted (Supabase): use the "Session pooler" string (works for app + migrations),
# or the "Transaction pooler" string here plus DIRECT_URL below for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/tritrainer?schema=public"

# OPTIONAL: direct/session connection used ONLY by Prisma Migrate (not the app).
# Set this when DATABASE_URL points at a transaction pooler (e.g. Supabase :6543),
# since poolers don't support the DDL/advisory locks migrations need.
# DIRECT_URL="postgresql://user:password@db.<ref>.supabase.co:5432/postgres"

# Secret used to sign auth sessions/tokens.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"

# Strava OAuth application credentials.
# Create an app at https://www.strava.com/settings/api
# Set the "Authorization Callback Domain" to your host (e.g. localhost).
STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"

# Symmetric key for encrypting Strava tokens at rest (AES-256-GCM).
# Must be base64-encoded 32 bytes. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY="generate-base64-32-bytes"

# OPTIONAL: shared token to validate the Strava webhook subscription handshake.
# STRAVA_WEBHOOK_VERIFY_TOKEN="your-random-verify-token"

# OPTIONAL: Garmin Connect Developer Program credentials (see
# GARMIN_INTEGRATION_PLAN.md — the program is not accepting new applications as
# of July 2026, so these stay unset; the Garmin integration is dormant without them).
# GARMIN_CLIENT_ID="your-garmin-consumer-key"
# GARMIN_CLIENT_SECRET="your-garmin-consumer-secret"

# OPTIONAL: bearer secret protecting POST /api/cron/weekly-digest (the weekly
# digest email batch). Point a daily cron at the route with this secret, e.g.
#   15 6 * * *  curl -s -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-host/api/cron/weekly-digest
# Unset = the route answers 503 and no digests are sent. Also requires SMTP.
# CRON_SECRET="generate-a-long-random-string"

# Canonical, fully-qualified URL of the app (used for OAuth callbacks + reset links).
NEXTAUTH_URL="http://localhost:3000"

# OPTIONAL: number of trusted reverse proxies in front of the app that append to
# X-Forwarded-For. Rate limiting derives the real client IP from this hop, so an
# attacker can't spoof XFF to dodge throttles. Default 0 (don't trust XFF).
# Set to 1 for a standard single reverse proxy (Hetzner/Passenger, nginx).
# TRUSTED_PROXY_COUNT="1"

# OPTIONAL: SMTP for transactional email (password-reset links). All optional —
# without them the app still runs; reset emails are simply skipped (in dev the
# reset link is logged to the server console so the flow is still testable).
# On Hetzner Webhosting, create a mailbox (e.g. noreply@richysdev.co.uk) in KonsoleH.
# SMTP_HOST="smtp.your-host.example"
# SMTP_PORT="587"
# SMTP_USER="noreply@richysdev.co.uk"
# SMTP_PASS="the-mailbox-password"
# MAIL_FROM="TriTrainer <noreply@richysdev.co.uk>"

# Sign in with Apple / Google Sign-In (mobile app: POST /api/auth/oauth; website: Auth.js).
# Audiences the server accepts on provider ID tokens. Leave a provider blank and
# that sign-in method answers 503 until it is configured.
APPLE_BUNDLE_ID="uk.co.richysdev.tritrainer"
# Apple Services ID used by the website Auth.js flow (also an accepted audience).
AUTH_APPLE_ID=""
# The Apple client secret is a short-lived JWT signed with the .p8 key (max 6 months).
AUTH_APPLE_SECRET=""
# Google OAuth client IDs: the Web client (Android tokens are issued for it) and the iOS client.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GOOGLE_IOS_CLIENT_ID=""
